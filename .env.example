# --- Fetching ---
SERP_PROXY=socks5h://127.0.0.1:1080
SERP_GOOGLE_HOST=www.google.com
SERP_ACCEPT_LANGUAGE=en-US,en;q=0.9
SERP_PACE_MIN=25
SERP_PACE_MAX=40

# --- Chrome (headful under Xvfb) ---
SERP_CHROME=/usr/bin/google-chrome
SERP_CHROME_LANG=en-US
SERP_DISPLAY=:78
SERP_CDP_PORT=9333
# SERP_PROFILE=/path/to/chrome-profile-serp

# --- Storage ---
# SERP_DATA_DIR=./.data
# SERP_CLIENTS_DIR=./serp_engine/clients

# --- AI probes ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
OPENROUTER_REFERER=https://example.com
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
GEMINI_API_KEY_FREE=
SERP_LLM_MODELS=gemini-flash-lite-latest,gemini-flash-latest
SERP_PPLX_MODEL=perplexity/sonar
SERP_OAI_MODEL=perplexity/sonar-pro
SERP_AI_WEEKLY_USD=0.50

# --- Delivery (all optional) ---
SERP_SHEET_ID=
GOOGLE_TOKEN_PATH=./token.json
SERP_WEB_ROOT=/var/www/serp-engine
SERP_WEB_BASE=https://ranks.example.com
SERP_WEB_TOKEN=change-me-random-path-segment
NTFY_SERVER=https://ntfy.sh
SERP_NTFY_TOPIC=your-private-topic

# --- Standalone CDP scripts (cdp/) ---
CDP_HOST=127.0.0.1
CDP_PORT=9222
SERP_HL=en
SERP_GL=us
